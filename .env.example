# ──────────────────────────────────────────────────────────────
# Configuracoes do Sistema Sefaz
# Copie este arquivo como .env e ajuste conforme necessario.
# ──────────────────────────────────────────────────────────────

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Origens permitidas pelo CORS (separadas por virgula). So importa se o
# front for servido de outra origem: pelo proxy do Vite nao ha CORS.
CORS_ORIGINS=http://localhost:5173

# Senha do usuario 'admin', usada apenas na criacao do banco (primeiro boot).
# Se ficar vazia, o sistema gera uma aleatoria e a registra no log de
# inicializacao — anote na hora, ela nao e exibida de novo.
# Usuarios comuns nao tem senha padrao: cada um recebe uma temporaria
# aleatoria na criacao e no reset, exibida uma unica vez ao admin.
ADMIN_PASSWORD=

# Titulo exibido na documentacao da API (Swagger)
APP_TITLE=Sistema Sefaz

# Documentacao interativa da API (/docs, /redoc, /openapi.json). Fica
# desligada por padrao: descreve a API inteira para quem nem fez login e
# o proxy do front a publica na rede. Ligue so em desenvolvimento.
API_DOCS=false

# Threads dos endpoints sincronos. Cada consulta ao ATF segura uma por
# ate 60 s; o padrao do AnyIO (40) deixava o login travar junto.
WORKER_THREADS=100

# Iteracoes do PBKDF2 nos hashes de senha (600 mil = recomendacao OWASP).
# Hashes antigos continuam validos e sao refeitos no primeiro login.
# PBKDF2_ITERATIONS=600000

# ──────────────────────────────────────────────────────────────
# API ATF (Ordens de Servico via HTTPS + XML)
# Se vazia, o sistema usara dados MOCK para desenvolvimento
# Exemplo: https://<host-do-atf>
# ──────────────────────────────────────────────────────────────

ATF_BASE_URL=

# URL do servico de DETALHE da OS (doc do detalhe), chamado ao abrir uma OS.
# Vazia = usa a mesma URL acima, que e o normal: os servicos devem
# apontar para o MESMO ambiente, senao a OS aberta no detalhe nao bate
# com a linha da listagem (nos ambientes de teste o contribuinte vem
# mascarado e a base e congelada numa data). So preencha se for mesmo
# necessario separa-los — ai a permissao de acesso passa a ser decidida
# pela listagem.
# Exemplo: https://<host-homologacao>
ATF_DETALHE_BASE_URL=

# URL do servico de EVENTOS de OS em lote (doc dos eventos), usado pela aba
# "Eventos" do Dashboard. Vazia = usa a mesma do ATF_BASE_URL, que e o
# normal.
#
# So preencha se o ambiente da listagem ainda nao publicar a operacao
# listarEventosOrdemServico: ai se aponta aqui um ambiente que a tenha.
# Com um host diferente do ATF_BASE_URL, a aba mostra um aviso vermelho:
# os numeros nao fecham com os da aba "Ordens de Servico" e nao servem
# para relatorio oficial.
# Diagnostico do servico, sem subir o backend:
#   python -m backend.verificar_eventos --url <URL> --dias 60
ATF_EVENTOS_BASE_URL=

# Caminho do endpoint SOAP, somado a ATF_BASE_URL. Ex: /servico/Recurso
ATF_WS_PATH=

# Verificacao do certificado TLS do ATF. Padrao: true (ligada).
# So use false em ambiente controlado e por tempo determinado: sem
# verificacao, a conexao fica exposta a interceptacao, e o trafego carrega
# dado fiscal e de contribuinte.
# Se o erro for "unable to get local issuer certificate", em geral o
# servidor esta enviando a cadeia incompleta — a correcao certa e no
# servidor. Do lado de ca, prefira montar um bundle com a intermediaria e
# apontar REQUESTS_CA_BUNDLE para ele, mantendo a verificacao ligada:
# false aqui desliga a verificacao para TODOS os servicos do ATF.
ATF_SSL_VERIFY=true
# REQUESTS_CA_BUNDLE=C:/caminho/para/bundle.pem

# Trocar qualquer variavel do ATF so vale depois de reiniciar o backend:
# o .env e lido uma vez, na inicializacao.

# Segundos que a resposta do ATF fica em cache. O servico devolve a lista
# inteira e nao pagina, entao sem cache cada troca de pagina ou clique de
# ordenacao refaz a consulta completa. 0 desliga.
ATF_CACHE_TTL=60
